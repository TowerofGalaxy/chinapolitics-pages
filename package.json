{
  "name": "langchao-yu-xingcheng",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check:story": "tsx scripts/compile-story.ts",
    "predev": "pnpm check:story",
    "dev": "vite --host 127.0.0.1",
    "pretypecheck": "pnpm check:story",
    "typecheck": "vue-tsc --noEmit",
    "pretest": "pnpm check:story",
    "test": "vitest run",
    "test:routes": "pnpm check:story && tsx scripts/find-routes.ts",
    "prebuild": "pnpm check:story",
    "build": "vue-tsc --noEmit && vite build"
  },
  "dependencies": {
    "dompurify": "^3.4.18",
    "marked": "^16.0.0",
    "vue": "^3.5.0",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.0.0"
  }
}
